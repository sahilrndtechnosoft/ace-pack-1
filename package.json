{
  "name": "acepack-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "export": "NEXT_EXPORT=true next build",
    "start": "next start",
    "lint": "next lint",
    "models:generate": "tsx scripts/generate-packaging.ts",
    "typecheck": "tsc --noEmit --incremental false",
    "models:validate": "node scripts/validate-packaging.mjs",
