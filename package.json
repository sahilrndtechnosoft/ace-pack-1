    "gsap": "^3.15.0",
    "jose": "^6.2.15",
    "lenis": "^1.3.26",
    "lucide-react": "^0.454.0",
    "mysql2": "^3.24.6",
    "next": "^15.5.24",
    "nodemailer": "^10.3.1",
    "react": "^19.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
