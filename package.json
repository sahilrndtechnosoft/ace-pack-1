    "start:prod": "ACEPACK_BUILD_DIR=.next-prod next start -p 4787"
  },
  "dependencies": {
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "bcryptjs": "^3.0.3",
