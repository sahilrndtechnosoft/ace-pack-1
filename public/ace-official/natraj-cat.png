<script>
    document.addEventListener("DOMContentLoaded", function () {
        const lazyBgElems = document.querySelectorAll(".lazy-bg");

        if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries, observer) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const el = entry.target;
                        const bg = el.getAttribute("data-bg");
                        if (bg) {
                            el.style.backgroundImage = `url('${bg}')`;
                            el.removeAttribute("data-bg");
                            observer.unobserve(el);
                        }
                    }
                });
            });
    
            lazyBgElems.forEach(el => observer.observe(el));
        } else {
            // Fallback: Load immediately
            lazyBgElems.forEach(el => {
                const bg = el.getAttribute("data-bg");
                if (bg) el.style.backgroundImage = `url('${bg}')`;
            });
        }
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        let overlay = document.getElementById('overlay');
        let popupContainer = document.getElementById('popup-container');
        let closeBtn = document.getElementById('close-btn');

        // Show the overlay and pop-up
        overlay.style.display = 'block';
        popupContainer.style.display = 'block';

        // Hide the overlay and pop-up when close button is clicked
        closeBtn.addEventListener('click', function() {
            overlay.style.display = 'none';
            popupContainer.style.display = 'none';
        });

        // Hide the overlay and pop-up after 2 seconds
        setTimeout(function() {
            overlay.style.display = 'none';
            popupContainer.style.display = 'none';
        }, 6000);
    });
</script>

