# Copy to .env and fill in. Never commit real values.

# MySQL (required)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=acepack_cms

# Signs admin login sessions (required, 32+ random characters, e.g. `openssl rand -base64 48`)
JWT_SECRET=

# First admin account, used only when the database has no admin yet (12+ characters)
ADMIN_EMAIL=admin@acepack.com
ADMIN_INITIAL_PASSWORD=

# Public site URL (canonical/sitemap host)
NEXT_PUBLIC_SITE_URL=https://www.acepack.co.in

# Outgoing email (contact form, document requests)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
